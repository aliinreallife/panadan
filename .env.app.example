# Initial admin password (14+ characters). Existing user password is retained in SQLite.
PANADAN_ADMIN_USER=admin
PANADAN_ADMIN_PASSWORD=
PANADAN_COOKIE_SECURE=false
# For a public HTTPS site, set BOTH of these in the private .env.app:
# PANADAN_COOKIE_SECURE=true
# PANADAN_PUBLIC_ORIGIN=https://dan.panafor.com
# This uses an explicit origin; the app does not trust X-Forwarded-* headers.
PANADAN_HTTP_PORT=8508
PANADAN_PG_PROXY_PORT=15432
# For immutable production images, optionally specify sha-tagged images:
# PANADAN_WEB_IMAGE=ghcr.io/aliinreallife/panadan-web:sha-<commit>
# PANADAN_VPN_IMAGE=ghcr.io/aliinreallife/panadan-vpn:sha-<commit>

# MCP authentication defaults to local manually issued bearer tokens.
PANADAN_MCP_AUTH_MODE=legacy
# OAuth mode requires an external OAuth 2.1 IdP, a real HTTPS resource URL,
# RS256-signed short-lived JWT access tokens and the exact audience/scope.
# Do not enable until the IdP, HTTPS endpoint and redirect flow are configured:
# PANADAN_MCP_AUTH_MODE=oauth
# PANADAN_OAUTH_ISSUER=https://identity.example.org
# PANADAN_OAUTH_JWKS_URL=https://identity.example.org/oauth/jwks
# PANADAN_OAUTH_RESOURCE=https://reports.example.org/mcp/
# PANADAN_OAUTH_SCOPE=panadan:mcp:read
# PANADAN_OAUTH_MAX_TOKEN_TTL=3600

# MCP SDK v2: default allowlist covers only localhost/127.0.0.1.
# For a future HTTPS reverse proxy, explicitly set the real public hostname:
# PANADAN_MCP_ALLOWED_HOSTS=reports.example.org,reports.example.org:443
# PANADAN_MCP_ALLOWED_ORIGINS=https://reports.example.org
# Never use * or expose a development-only HTTP port publicly.
