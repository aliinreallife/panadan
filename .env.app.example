# Set a unique password (14+ characters), then chmod 600 .env.app.
# Used ONLY to create the initial account; existing accounts do not reset on restart.
PANADAN_ADMIN_USER=admin
PANADAN_ADMIN_PASSWORD=
# Local HTTP testing. Change to true with HTTPS reverse proxy.
PANADAN_COOKIE_SECURE=false
PANADAN_HTTP_PORT=8508
