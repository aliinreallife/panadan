# Initial admin password (14+ characters). Existing user password is retained in SQLite.
PANADAN_ADMIN_USER=admin
PANADAN_ADMIN_PASSWORD=
PANADAN_COOKIE_SECURE=false
PANADAN_HTTP_PORT=8508
PANADAN_PG_PROXY_PORT=15432
# For immutable production images, optionally specify sha-tagged images:
# PANADAN_WEB_IMAGE=ghcr.io/aliinreallife/panadan-web:sha-<commit>
# PANADAN_VPN_IMAGE=ghcr.io/aliinreallife/panadan-vpn:sha-<commit>
