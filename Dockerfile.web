# Production image: builds in GitHub Actions, not on Docker Desktop.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=0 \
    UV_LINK_MODE=copy \
    PATH="/srv/.venv/bin:$PATH"
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project
COPY server/ ./server/
COPY static/ ./static/
COPY templates/ ./templates/
RUN useradd --system --create-home --uid 10001 panadan \
    && mkdir -p /data && chown panadan:panadan /data
USER panadan
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
