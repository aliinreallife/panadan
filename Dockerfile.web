FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd -m -u 10001 panadan
COPY server ./server
COPY templates ./templates
COPY static ./static
RUN mkdir -p /data && chown -R panadan:panadan /data /srv
USER panadan
CMD ["uvicorn","server.main:app","--host","0.0.0.0","--port","8000","--no-proxy-headers"]
