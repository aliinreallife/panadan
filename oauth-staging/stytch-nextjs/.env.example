# Test-only PUBLIC token from Stytch > Project Overview > API Keys.
# Never put a Stytch Secret Key here; this app must remain in Test.
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=public-token-test-REPLACE_ME

# Non-secret Stytch Test Project ID, used for local public-client code exchange.
STYTCH_TEST_PROJECT_ID=project-test-REPLACE_ME
