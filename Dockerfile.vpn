FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends openvpn iptables iproute2 postgresql-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY start-vpn.sh /usr/local/bin/start-vpn.sh
RUN chmod 755 /usr/local/bin/start-vpn.sh
WORKDIR /vpn
ENTRYPOINT ["/usr/local/bin/start-vpn.sh"]
