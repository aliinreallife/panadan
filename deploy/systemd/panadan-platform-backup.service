[Unit]
Description=Panadan owned PostgreSQL 18 encrypted off-site backup (optional)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/panadan/backup.env
WorkingDirectory=/home/panafor/panadan
ExecStartPre=/usr/bin/bash /home/panafor/panadan/tools/backup-platform-offsite.sh --check
ExecStart=/usr/bin/bash /home/panafor/panadan/tools/backup-platform-offsite.sh
TimeoutStartSec=30min
NoNewPrivileges=true
